SECRET_KEY=sua_chave_secreta_aqui_nao_subir_para_o_git
DEBUG=True
ALLOWED_HOST=127.0.0.1

DB_NAME=nome_do_banco_aqui
DB_USER=usuario_do_banco_aqui
DB_PASSWORD=senha_aqui
DB_HOST=localhost
DB_PORT=5432

# Em produção no Render, prefira a Internal Database URL do PostgreSQL.
DATABASE_URL=postgresql://usuario:senha@host-interno:5432/nome_do_banco

# Redis para channel layer (WebSocket / tempo real).
# Em produção no Render é injetado automaticamente.
# Em dev pode ficar vazio — fallback para InMemoryChannelLayer.
REDIS_URL=redis://usuario:senha@host:6379

# Integração com sistema externo (Dias Conectado / módulo de atendimentos).
# Deixe vazio para desabilitar a integração.
INTEGRADOR_BASE_URL=https://api.externa.exemplo.com
INTEGRADOR_TOKEN=seu_token_aqui
